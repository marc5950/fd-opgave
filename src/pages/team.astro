---
//@ts-nocheck
import Layout from "@layouts/Layout.astro";
import employeesData from "@data/employees.json";
import DynamicIcon from "../components/helpers/DynamicIcon.astro";
import HeroBgWrapper from "@components/helpers/HeroBgWrapper.astro";
---

<Layout title="Team - AskExperts">
  <HeroBgWrapper imagePath="team-hero.jpg" class="hero-bg">
    <section class="container" style=" padding: 4rem 0;">
      <div class="team-hero">
        <p>Team</p>
        <h2 style="--font-size: var(--heading01)">The Consultors</h2>
      </div>
    </section>
  </HeroBgWrapper>
  <section class="container">
    <div class="about-title">
      <div>
        <h2>Meet Our Great Team</h2>
        <p>
          Welcome to our amazing team! We are a group of passionate individuals
          dedicated to excellence and innovation. Each member brings unique
          skills and experiences, working together to achieve our goals. Join us
          as we embark on exciting projects and create lasting impacts.
        </p>
      </div>
      <a class="button01" href="#">Join our team</a>
    </div>
    <ul class="employees">
      {
        employeesData.map((employee) => (
          <li>
            <a href={`/team/${employee.slug}`}>
              <img src={employee.img} alt={employee.name} />
              <p>{employee.title}</p>
            </a>
            <h3 style="--font-size: var(--heading05)">{employee.name}</h3>
            <p style="--text-color: var(--text-gray)">{employee.description}</p>
            <ul class="SoMe">
              {employee.social_links.map((link) => (
                <li>
                  <a href={link.url}>
                    <DynamicIcon name={link.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section></Layout
>

<style>
  .team-hero {
    margin-top: calc(73px + 2rem);
    display: inline-flex;
    padding: 48px 60px 58px 60px;
    flex-direction: column;
    max-width: 100ch;
    height: fit-content;
    gap: 10px;
    border-radius: 29px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(5.5px);

    p {
      text-transform: uppercase;
      background: var(--primary-color01);
      width: fit-content;
      padding: 0 15px;
      border-radius: 20px;
    }
  }

  .container {
    row-gap: 2rem;
  }
  .about-title {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2rem;
    align-items: end;
    div {
      display: flex;
      flex-direction: column;
      max-width: 65ch;
      gap: 1rem;
    }

    @media (max-width: 900px) {
      flex-direction: column;
      align-items: start;
      gap: 3rem;
    }
  }
  .employees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    text-align: center;

    > li {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      h3 {
        margin-bottom: -1rem;
      }
    }
    a {
      display: grid;
      img {
        grid-area: 1 / 1;
        border-radius: 10px;
      }
      p {
        place-self: end end;
        grid-area: 1 / 1;
        padding: 0.25rem 1rem;
        margin: 1rem 0.25rem;
        border-radius: 30px;
        color: var(--text-light);
        background: var(--primary-color03);
        transition: all 0.3s ease;
      }
      &:hover {
        p {
          background: var(--primary-color01);
          color: var(--text-dark);
        }
      }
    }
    .SoMe {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
    }
  }
</style>
